{
  "name": "facilitador-tiktok-shop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker/index.ts",
    "dev:web": "vite",
    "migrate": "tsx --env-file-if-exists=.env src/server/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env src/server/seed.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "worker": "tsx src/worker/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "custos": "tsx scripts/custos.ts",
    "build:demo": "node scripts/build-demo.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "archiver": "^8.0.0",
    "fastify": "^5.12.5",
    "motion": "^14.1.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "stripe": "^23.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
