# Worker de vídeo: precisa do FFmpeg. Rode quantas cópias quiser para processar mais lotes ao mesmo tempo.
FROM node:22-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
RUN npm ci --omit=dev
COPY src ./src
COPY db ./db
CMD ["npx", "tsx", "src/worker/index.ts"]
