# Copie para .env e preencha. Tudo que está vazio tem um modo de desenvolvimento.

# Endereço público do site (usado em links de pagamento e e-mails)
APP_URL=http://localhost:5173
PORT=3000

# Banco de dados Postgres (Railway, Supabase, Neon...)
DATABASE_URL=postgres://fts:fts@localhost:5432/fts

# Segredo para assinar as sessões de login (gere com: openssl rand -hex 32)
SESSION_SECRET=troque-este-segredo

# Armazenamento dos vídeos
# STORAGE_DRIVER=local salva em ./data (só para desenvolvimento)
# STORAGE_DRIVER=s3 usa Cloudflare R2 / AWS S3 / qualquer S3 compatível
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# IA (roteiros). Sem chave, os roteiros saem de um gerador de exemplo.
ANTHROPIC_API_KEY=
# Modelo padrão: claude-opus-5-5. Para cortar o custo de IA, troque por claude-haiku-5-5 (veja docs/CUSTOS.md).
ANTHROPIC_MODEL=claude-opus-5-5

# Pagamentos (Stripe). Sem chave, o checkout ativa o plano direto (modo demonstração).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# Worker de vídeo
WORKER_CONCURRENCY=1
# Dias que os vídeos gerados ficam guardados antes de serem apagados
OUTPUT_RETENTION_DAYS=7

# E-mails com acesso à área de administração (separados por vírgula)
ADMIN_EMAILS=
